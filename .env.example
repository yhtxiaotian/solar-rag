ENVIRONMENT=production
SITE_ADDRESS=http://localhost

POSTGRES_DB=solar_rag
POSTGRES_USER=solar
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://solar:replace-with-a-long-random-password@postgres:5432/solar_rag
REDIS_URL=redis://redis:6379/0
STORAGE_PATH=/data/knowledge

AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=replace-with-provider-key
CHAT_MODEL=deepseek-v4-flash
RERANK_MODEL=deepseek-v4-flash
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
LOCAL_EMBEDDING_CACHE_PATH=/home/appuser/.cache/fastembed
AI_TIMEOUT_SECONDS=90
AI_OFFLINE_MODE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-argon2-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
RATE_LIMIT_SALT=replace-with-another-random-value
TRUST_PROXY_HEADERS=true

GUEST_REQUESTS_PER_HOUR=20
GLOBAL_REQUESTS_PER_DAY=500
GLOBAL_TOKENS_PER_DAY=2000000
MAX_FILE_SIZE_MB=100
URL_HOST_ALLOWLIST=
CONVERSATION_RETENTION_DAYS=30

USE_DOCLING=true
ENABLE_OCR=true
CELERY_ALWAYS_EAGER=false
ALLOWED_ORIGINS=http://localhost,http://localhost:3000
